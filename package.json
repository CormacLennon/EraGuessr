{
  "name": "era-guessr",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "data:fetch": "node scripts/fetch-data.ts",
    "data:prepare": "node --max-old-space-size=12000 scripts/prepare-data.ts",
    "puzzles:generate": "node --max-old-space-size=8192 scripts/generate-puzzles.ts",
    "dev:client": "npm --workspace client run dev",
    "dev:server": "npm --workspace server run dev",
    "typecheck": "tsc -p tsconfig.json && npm --workspace client run build",
    "data:convert": "node --max-old-space-size=8192 scripts/convert-ohm.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "mapshaper": "0.7.90",
    "typescript": "~7.0.2"
  }
}
